	CREATE DATABASE SAUDECONECTA;

USE SAUDECONECTA;

CREATE TABLE  Patient (
PatientID INT PRIMARY KEY AUTO_INCREMENT,
Patientname VARCHAR (120) NOT NULL,
CPF VARCHAR (14) NOT NULL,
birthdate DATE,
phone VARCHAR (20),
email VARCHAR (120),
CONSTRAINT patient_cpf UNIQUE (cpf)
);

CREATE TABLE DOCTOR (
DoctorID INT PRIMARY KEY AUTO_INCREMENT,
Doctorname VARCHAR (120),
crm VARCHAR (20),
specialty VARCHAR (100),
PHONE VARCHAR (20),
CONSTRAINT doctor_crm UNIQUE(crm)
);

CREATE TABLE medication (
medicationID INT PRIMARY KEY AUTO_INCREMENT,
MedicationName VARCHAR (120),
activeIngredient VARCHAR (120),
Strenght VARCHAR (20)
);

CREATE TABLE ADDRESS (
AddressID INT PRIMARY KEY AUTO_INCREMENT,
ZipCode VARCHAR (10),
Street VARCHAR (150),
Number VARCHAR (20),
complement  VARCHAR (100)
);

CREATE TABLE avaibleslots (
slotid INT PRIMARY KEY AUTO_INCREMENT,
doctorid INT,
dayofweek VARCHAR (15),
starttime TIME,
endtime TIME,
CONSTRAINT fk_availableslots_doctor
	FOREIGN KEY (doctorid) REFERENCES doctor (doctorid)
    ON DELETE RESTRICT
);

CREATE TABLE APPOINTMENT (
appointmentID INT PRIMARY KEY AUTO_INCREMENT,
patientID INT,
DoctorID INT,
appoitmentdate DATETIME,
status VARCHAR (20),
notes TEXT,
CONSTRAINT fk_appointment_patient
    FOREIGN KEY (patientID) REFERENCES patient (patientid)
    ON DELETE RESTRICT,
CONSTRAINT fk_apponintment_doctor
    FOREIGN KEY (doctorID) REFERENCES doctor (doctorid)
    ON DELETE RESTRICT
);

CREATE TABLE EXAM (
examID INT PRIMARY KEY AUTO_INCREMENT,
appointmentID INT,
examname VARCHAR (120),
RequestDate DATETIME,
CONSTRAINT fk_exam_appointment
    FOREIGN KEY (appointmentID) REFERENCES appointment (appointmentID)
    ON DELETE RESTRICT
);

CREATE TABLE ExamResult (
ExamResultID INT PRIMARY KEY AUTO_INCREMENT,
EXAMID INT,
value VARCHAR (100),
RESULT TEXT,
resultDATE DATETIME,
CONSTRAINT fk_examresult_exam
    FOREIGN KEY (EXAMID) REFERENCES EXAM (EXAMID)
    ON DELETE RESTRICT
);

CREATE TABLE SCHEDULE (
scheduleID INT PRIMARY KEY AUTO_INCREMENT,
doctorID INT,
PATIENTID INT,
scheduledate DATETIME ,
CONSTRAINT fk_schedule_doctor
    FOREIGN KEY (doctorid) REFERENCES doctor (doctorid)
    ON DELETE RESTRICT,
CONSTRAINT fk_schedule_patient
    FOREIGN KEY (patientid) REFERENCES patient (patientid)
	ON DELETE RESTRICT
);

CREATE TABLE INVOICE (
InvoiceID INT PRIMARY KEY AUTO_INCREMENT,
appointmentid INT, 
totalamount DECIMAL (10,2),
issueTIME DATETIME,
status VARCHAR (20),
CONSTRAINT fk_invoice_appointment
    FOREIGN KEY (appointmentID) REFERENCES appointment (appointmentid)
    ON DELETE RESTRICT,
CONSTRAINT check_invoice_nonegative
	CHECK (totalamount >= 0)
);

CREATE TABLE PaymentID (
paymentid INT PRIMARY KEY AUTO_INCREMENT,
invoiceID INT,
paidamount DECIMAL (10,2),
paymentmethod VARCHAR (30),
paymentdate DATETIME,
paymentstatus ENUM('Aprovado','Recusado','Em analise','Cancelado'),
CONSTRAINT fk_payment_invoice
    FOREIGN KEY (invoiceid) REFERENCES INVOICE (INVOICEID)
    ON DELETE RESTRICT,
CONSTRAINT check_payment_nonegative
	CHECK (paidamount >= 0)
);

CREATE TABLE Prescription (
prescriptionid INT PRIMARY KEY AUTO_INCREMENT,
appointmentid INT,
doctorid INT,
issuedate DATETIME,
notes TEXT,
validuntil DATE,
status VARCHAR(20),
CONSTRAINT fk_prescription_appointment
    FOREIGN KEY (appointmentid) REFERENCES appointment(appointmentid)
    ON DELETE RESTRICT,
CONSTRAINT fk_prescription_doctor
	FOREIGN KEY (doctorid) REFERENCES doctor(doctorid)
    ON DELETE RESTRICT
);
CREATE TABLE Prescription_item ( 
prescriptionitemid INT PRIMARY KEY AUTO_INCREMENT,
medicationid INT,
prescriptionid INT, 
appointmentid INT,
doctorid INT, 
issuedate DATETIME,
notes TEXT,
valid_until DATE,
status VARCHAR(20),
CONSTRAINT fk_prescitem_medication
    FOREIGN KEY (medicationid) REFERENCES medication(medicationid)
    ON DELETE RESTRICT,
CONSTRAINT fk_prescitem_prescription
    FOREIGN KEY (prescriptionid) REFERENCES prescription(prescriptionid)
    ON DELETE RESTRICT
);
CREATE TABLE contact (
contactid INT PRIMARY KEY AUTO_INCREMENT,
patientid INT,
doctorid INT,
CONSTRAINT fk_contact_patient
	FOREIGN KEY (patientid) REFERENCES patient(patientid)
    ON DELETE RESTRICT,
CONSTRAINT fk_contact_doctor
    FOREIGN KEY (doctorid) REFERENCES doctor(doctorid)
    ON DELETE RESTRICT
); 

